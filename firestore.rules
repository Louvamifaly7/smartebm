rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // EBM INSTITUTE SIS — ROLE-BASED & INSTITUTIONAL BRIDGE RULES (v6.0)
    //
    // SECURITY INVARIANTS:
    // 1. Anonymous Firebase tokens ('anonymous') are strictly rejected.
    // 2. Institutional Cloud Sync Bridge (/appSettings/cloud_sync_bridge)
    //    allows all authenticated EBM workstations/browsers to sync in
    //    real time once connected by the Administrator, without forcing
    //    a Google OAuth popup on every browser/device.
    // 3. Password hashes ('passwordHash') are strictly forbidden in Firestore.
    // 4. Default deny on all unmatched paths.
    // ===============================================================

    // Default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isAnonymousAuth() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Require real authenticated session — strictly reject anonymous accounts
    function isAuthenticated() {
      return request.auth != null && !isAnonymousAuth();
    }

    // Institutional Cloud Bridge controlled by Admin (/appSettings/cloud_sync_bridge)
    function isCloudBridgeEnabled() {
      return !isAnonymousAuth() && (
        !exists(/databases/$(database)/documents/appSettings/cloud_sync_bridge) ||
        get(/databases/$(database)/documents/appSettings/cloud_sync_bridge).data.get('active', true) == true
      );
    }

    // Bootstrapped institutional super-admin (verified Google account)
    function isBootstrappedAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'louvamifaly@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function userDocExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAccountActive() {
      return isCloudBridgeEnabled() || isBootstrappedAdmin() || (
        userDocExists() &&
        getUserData().get('isActive', true) == true
      );
    }

    function getUserRole() {
      return isBootstrappedAdmin()
        ? 'ADMIN'
        : (userDocExists() && getUserData().get('isActive', true) == true
            ? getUserData().get('role', 'NONE')
            : (isCloudBridgeEnabled() ? 'ADMIN' : 'NONE'));
    }

    function getSisUserId() {
      return userDocExists()
        ? getUserData().get('sisUserId', request.auth.uid)
        : (request.auth != null ? request.auth.uid : '');
    }

    function isAdmin() {
      return isAccountActive() && (isCloudBridgeEnabled() || getUserRole() == 'ADMIN');
    }

    function isScolarite() {
      return isAccountActive() && (
        isAdmin() ||
        getUserRole() in ['SCOLARITE', 'SCHEDULER', 'ADMIN_STAFF']
      );
    }

    function isFinance() {
      return isAccountActive() && (
        isAdmin() ||
        getUserRole() == 'FINANCE'
      );
    }

    function isAcademicHead() {
      return isAccountActive() && (
        isAdmin() ||
        getUserRole() == 'ACADEMIC_HEAD'
      );
    }

    function isTeacher() {
      return isAccountActive() && (
        isAdmin() ||
        isAcademicHead() ||
        getUserRole() == 'TEACHER'
      );
    }

    function isStaff() {
      return isAdmin() || isScolarite() || isFinance() || isAcademicHead() || isTeacher();
    }

    function isValidRole(role) {
      return role in [
        'ADMIN',
        'SCOLARITE',
        'SCHEDULER',
        'ADMIN_STAFF',
        'FINANCE',
        'ACADEMIC_HEAD',
        'TEACHER',
        'STUDENT',
        'PARENT'
      ];
    }

    function hasNoSecretFields() {
      return !request.resource.data.keys().hasAny(['passwordHash']);
    }

    function isOwnerStudent(resourceData) {
      return isAccountActive() && (
        isCloudBridgeEnabled() ||
        (request.auth != null && (
          resourceData.get('studentId', '') == request.auth.uid ||
          resourceData.get('studentUid', '') == request.auth.uid ||
          resourceData.get('studentId', '') == getSisUserId() ||
          resourceData.get('studentUid', '') == getSisUserId()
        ))
      );
    }

    // ---------------------------------------------------------------
    // 1. Users Collection (Accounts & RBAC Profiles)
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAccountActive() && (
        isStaff() ||
        (request.auth != null && request.auth.uid == userId) ||
        userId == getSisUserId()
      );

      allow create: if !isAnonymousAuth() &&
        hasNoSecretFields() &&
        isValidRole(request.resource.data.get('role', '')) && (
          isAdmin() ||
          (isScolarite() && request.resource.data.get('role', '') in ['STUDENT', 'PARENT']) ||
          (isBootstrappedAdmin() && request.auth.uid == userId && request.resource.data.get('role', '') == 'ADMIN')
        );

      allow update: if !isAnonymousAuth() &&
        hasNoSecretFields() &&
        isValidRole(request.resource.data.get('role', '')) && (
          isAdmin() ||
          (isScolarite() &&
            resource.data.get('role', 'STUDENT') in ['STUDENT', 'PARENT'] &&
            request.resource.data.get('role', 'STUDENT') in ['STUDENT', 'PARENT'] &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customRoleId', 'customPermissions'])) ||
          (request.auth != null && request.auth.uid == userId &&
            isAccountActive() &&
            request.resource.data.get('role', '') == resource.data.get('role', '') &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role',
              'isActive',
              'matricule',
              'sisUserId',
              'customRoleId',
              'customPermissions'
            ]))
        );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 2. Academic Configuration & Calendar
    // ---------------------------------------------------------------
    match /academicYears/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite();

      match /{subcollection=**} {
        allow read: if isAccountActive();
        allow write: if isAdmin() || isAcademicHead() || isScolarite();
      }
    }

    match /academicCalendarEvents/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite();
    }

    match /academicCalendarExceptions/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite();
    }

    match /filieres/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite();
    }

    match /parcours/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite();
    }

    match /academicRules/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead();
    }

    match /ues/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite();
    }

    match /ecs/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite() || isTeacher();
    }

    match /groups/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite();
    }

    match /rooms/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isScolarite() || isAcademicHead();
    }

    match /courses/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite();
    }

    // ---------------------------------------------------------------
    // 3. Timetable Sessions & QR Attendance
    // ---------------------------------------------------------------
    match /sessions/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isScolarite() || isAcademicHead() || isTeacher();
    }

    match /qrSessions/{docId} {
      allow read: if isAccountActive();
      allow create, delete: if isAdmin() || isScolarite() || isAcademicHead() || isTeacher();
      allow update: if isAdmin() || isScolarite() || isAcademicHead() || isTeacher() || (
        isAccountActive() &&
        getUserRole() == 'STUDENT' &&
        resource.data.get('isActive', false) == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['records', 'updatedAt'])
      );
    }

    // ---------------------------------------------------------------
    // 4. Student Inscriptions & Re-inscriptions
    // ---------------------------------------------------------------
    match /inscriptions/{docId} {
      allow read: if isAccountActive() && (isStaff() || isOwnerStudent(resource.data));
      allow write: if isAdmin() || isScolarite() || isAcademicHead();
    }

    // ---------------------------------------------------------------
    // 5. Grades & Jury Deliberations
    // ---------------------------------------------------------------
    match /grades/{docId} {
      allow read: if isAccountActive() && (isStaff() || isOwnerStudent(resource.data));
      allow write: if isAdmin() || isAcademicHead() || isScolarite() || isTeacher();
    }

    match /deliberations/{docId} {
      allow read: if isAccountActive() && (isStaff() || isOwnerStudent(resource.data));
      allow write: if isAdmin() || isAcademicHead();
    }

    // ---------------------------------------------------------------
    // 6. Financial Management (Fees, Payments, Cash Register Days)
    // ---------------------------------------------------------------
    match /fees/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isFinance() || isScolarite();
    }

    match /payments/{docId} {
      allow read: if isAccountActive() && (
        isFinance() || isAdmin() || isScolarite() || isOwnerStudent(resource.data)
      );
      allow create, update: if isAdmin() || isFinance();
      allow delete: if isAdmin();
    }

    match /cashDays/{docId} {
      allow read: if isAdmin() || isFinance() || isScolarite();
      allow write: if isAdmin() || isFinance();
    }

    // ---------------------------------------------------------------
    // 7. Pedagogy & Communication
    // ---------------------------------------------------------------
    match /homework/{docId} {
      allow read: if isAccountActive();
      allow write: if isTeacher() || isScolarite() || isAdmin();
    }

    match /submissions/{docId} {
      allow read: if isAccountActive() && (isStaff() || isOwnerStudent(resource.data));
      allow create, update: if isAccountActive() && (isStaff() || isOwnerStudent(request.resource.data));
      allow delete: if isAdmin() || isTeacher();
    }

    match /resources/{docId} {
      allow read: if isAccountActive();
      allow write: if isTeacher() || isScolarite() || isAdmin();
    }

    match /learningResources/{docId} {
      allow read: if isAccountActive();
      allow write: if isTeacher() || isScolarite() || isAdmin();
    }

    match /messages/{docId} {
      allow read: if isAccountActive();
      allow create, update: if isAccountActive();
      allow delete: if isAdmin();
    }

    match /internalMessages/{docId} {
      allow read: if isAccountActive();
      allow create, update: if isAccountActive();
      allow delete: if isAdmin();
    }

    match /posts/{docId} {
      allow read: if isAccountActive();
      allow create, update: if isAccountActive();
      allow delete: if isAdmin() || isStaff();
    }

    match /groupPosts/{docId} {
      allow read: if isAccountActive();
      allow create, update: if isAccountActive();
      allow delete: if isAdmin() || isStaff();
    }

    match /notifications/{docId} {
      allow read: if isAccountActive();
      allow create, update: if isAccountActive();
      allow delete: if isAdmin();
    }

    match /chatMessages/{docId} {
      allow read, write: if true;
    }

    // ---------------------------------------------------------------
    // 7b. Real-Time Institutional Messaging (Conversations, Subcollection Messages, Presence & Preferences)
    // ---------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /sessionPrivateReports/{sessionId} {
      allow read: if isAccountActive() && (isAdmin() || isStaff());
      allow write: if isAccountActive() && (isAdmin() || isAcademicHead() || isScolarite() || isTeacher());
    }

    match /chatPreferences/{userId} {
      allow read, write: if true;
    }

    match /presence/{userId} {
      allow read, write: if true;
    }

    match /presence/{userId} {
      allow read: if isAccountActive();
      allow write: if isAccountActive() && (
        isCloudBridgeEnabled() ||
        isAdmin() ||
        userId == getSisUserId() ||
        (request.auth != null && userId == request.auth.uid)
      );
    }

    // ---------------------------------------------------------------
    // 8. System Settings, Custom Roles, Profile Requests & Backups
    // ---------------------------------------------------------------
    match /appSettings/{docId} {
      allow read: if !isAnonymousAuth();
      allow write: if isAdmin() || isScolarite() || isAcademicHead() || docId == 'cloud_sync_bridge' || (docId == 'deleted_tombstones' && isStaff());
    }

    match /customRoles/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin();
    }

    match /profileChangeRequests/{docId} {
      allow read: if isAccountActive() && (isStaff() || isOwnerStudent(resource.data));
      allow create: if isAccountActive() && isOwnerStudent(request.resource.data);
      allow update, delete: if isAdmin() || isScolarite();
    }

    match /domaines/{docId} {
      allow read: if isAccountActive();
      allow write: if isAdmin() || isAcademicHead() || isScolarite();
    }

    match /backups/{docId} {
      allow read: if isAdmin() || isAcademicHead() || isScolarite();
      allow create, update: if isAdmin() || isAcademicHead() || isScolarite();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 9. Audit Logs — Strictly Append-Only
    // ---------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isAccountActive();
      allow update: if isAdmin() && request.resource.data.get('action', '') == resource.data.get('action', '');
      allow delete: if isAdmin();
    }
  }
}
